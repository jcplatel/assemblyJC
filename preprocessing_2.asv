%% Load settings
MinPeakDistancesce=5 ;% 5 default
MinPeakDistance=3;% 3 default
threshold_peak=3;% 3 default
% sampling_rate=10;
synchronous_frames=round(0.2*sampling_rate,0); %200ms *sampling rate
synchronous_frames=2; %2 default
% kmean_iter=100;
% kmeans_surrogate=100;
percentile=NaN;
sce_n_cells_threshold = 5;
%%%%




%% Load current data
load(strcat(path, 'Fall.mat'), 'ops');

% Récupérer la corrélation calculée par Suite2p (sur images recalées)
% C'est un vecteur de taille (nFrames x 1)
frame_corr = double(ops.corrXY); 

% Déterminer un seuil statistique pour identifier les "décrochages" (Z-motion)
% On prend la médiane (plus robuste que la moyenne) comme ligne de base
baseline = median(frame_corr);

% On estime l'écart-type du bruit sur la partie stable uniquement
% (On ignore les chutes brutales pour le calcul de la variance)
stable_frames = frame_corr(frame_corr > baseline - 0.05); 
sigma = std(stable_frames);

% Définir le seuil de rejet (ex: 3 ou 4 écarts-types sous la baseline)
seuil_bad = baseline - 4 * sigma; 
% Ou un seuil empirique fixe si c'est plus simple pour vous (ex: 0.5)

% Identifier les mauvaises frames
bad_frames = frame_corr < seuil_bad;

% --- Visualisation ---
figure;
plot(frame_corr, 'k'); hold on;
yline(seuil_bad, 'r--', 'Seuil Bad Frames');
plot(find(bad_frames), frame_corr(bad_frames), 'r.', 'MarkerSize', 10);
title('Qualité de l''enregistrement (Corrélation post-recalage)');
ylabel('Corrélation avec RefImg');
xlabel('Frames');
legend('Corrélation', 'Seuil', 'Frames rejetées');

fprintf('Nombre de frames rejetées (Z-motion/Flou) : %d sur %d (%.2f%%)\n', ...
    sum(bad_frames), length(frame_corr), 100*sum(bad_frames)/length(frame_corr));
plot (speed/200-(-0.04))


% Tr1b=double(F(iscell(:,1)>0,:));
Tr1b=double(F);
% clear F
% Tr1b=F(colorcell<7,:);
% if mean(Tr1b,"all")>10000
%     disp('pb intensity DF')
%     return
% end
speedsm =smoothdata(speed,'gaussian',50);
[NCell,Nz] = size(Tr1b);
% disp (['Ncells= ' num2str(NCell)])
fprintf('Ncells= %d ;' , NCell)
% median normalize

% disp('median normalization')

%bleaching correction
Tr1b = sgolayfilt(Tr1b',3,9)';
% ws = warning('off','MATLAB:polyfit:RepeatedPointsOrRescale');
% for i=1:NCell
%     p0=polyfit(1:Nz,Tr1b(i,:),3);
%     Tr1b(i,:)=Tr1b(i,:)./polyval(p0,1:Nz);
% end
% warning(ws)%% preprocessing

window_size = 500; % Largeur de la fenêtre en points temporels
percentile_value=5;
num_blocks = ceil(Nz / window_size);
for n=1:NCell
    trace=Tr1b(n,:);
    F0 = nan(Nz, 1);
    % Calcul du percentile bloc par bloc
    for i = 1:num_blocks
        start_idx = (i-1) * window_size + 1;
        end_idx = min(i * window_size, Nz);
        F0(start_idx:end_idx) = prctile(trace(start_idx:end_idx), percentile_value);
    end
    F0 = movmedian(F0, window_size, 'omitnan');
    F0 = smoothdata (F0,1,"gaussian",window_size/2);
    Tr1b(n,:)=(trace-F0')./F0';
end

% %refine only for speed<2
WinRest=find(speedsm<=2);
WinActive=find(speedsm>2);
MovT=transpose(1:Nz);  %put real time

% Detect Calcium Transients using a sliding window
Raster = zeros(NCell,Nz);
Acttmp2 = cell(1,NCell);
ampli = cell(1,NCell);
minithreshold=0.1; 

for i=1:NCell    
    % th(i)=threshold_peak*std(Tr1b(i,WinRest));%2.576=99% 3=99.7 , 3.291=99.9
    mad_trace = mad(Tr1b(i, WinRest), 1); % '1' pour centrer sur la médiane
    th(i) = threshold_peak * mad_trace * 1.4826; % Le facteur 1.4826 normalise le MAD pour le rendre comparable à l'écart-type
    [amplitude,locs] = findpeaks(Tr1b(i,:),'MinPeakProminence',th(i) ,'MinPeakDistance',MinPeakDistance);
    %%remove highest peak???
    valeurs_identiques = intersect (locs,WinActive);
    [locs_sans_ide , idx ]=setdiff(locs(:), valeurs_identiques);
    ampli_sans_ide=amplitude(idx);
    Acttmp2{i}=locs_sans_ide;%%%%%%%%findchangepts(y,MaxNumChanges=10,Statistic="rms")
end

% %f = figure('visible','off');
for i = 1:NCell
    if Acttmp2{i}>0
        Raster(i,Acttmp2{i}) = 1;           %Raster = real raster of cell activity
    end
end
% % 
% % Sum activity over n (synchronous_frames ) consecutive frames
%remove too high synchrony
nombre_transients_par_cellule = cellfun(@length, Acttmp2);
seuil_frequence = prctile(nombre_transients_par_cellule, 98);
cellules_hyperactives_idx = find(nombre_transients_par_cellule > seuil_frequence);
if ~isempty(cellules_hyperactives_idx)
    % fprintf('%d cellules hyperactives neutralisées (leur activité est mise à zéro dans le Raster).\n', length(cellules_hyperactives_idx));
    Raster(cellules_hyperactives_idx, :) = 0;        % Pour chaque cellule hyperactive identifiée, mettez toute sa ligne dans le Raster à zéro
end

SumAct=sum(Raster,1);
[pks,locs] = findpeaks(SumAct,'MinPeakHeight',sce_n_cells_threshold,'MinPeakDistance',MinPeakDistancesce);

absolute_threshold = 100; %ou 80 ou 100 ??
TF_relative = isoutlier(pks, "percentiles", [0 95]);
TF_absolute = pks > absolute_threshold;
TF_combined = TF_relative & TF_absolute;
idx_to_remove = find(TF_combined);
if ~isempty(idx_to_remove)
    Raster(:, locs(idx_to_remove)) = 0;
end

MAct = zeros(1,Nz-synchronous_frames);          %MAct= Sum active cells 
for i=1:Nz-synchronous_frames
    MAct(i) = sum(max(Raster(:,i:i+synchronous_frames),[],2));
end

% disp(['Sum transient: ' num2str(sum(MAct))])
fprintf ('Sum transient: %d ;' , sum(MAct))
[pks,TRace] = findpeaks(MAct,'MinPeakHeight',sce_n_cells_threshold,'MinPeakDistance',MinPeakDistancesce);

NRace = length(TRace);

% disp(['nSCE: '  num2str(NRace)])
fprintf ('nSCE: %d ;' , NRace)

% Create Race = cells that participate in SCE 
% Race = zeros(NCell,NRace);
Race = false(NCell, NRace);
RasterRace = zeros(NCell,Nz);
for i = 1:NRace
    % Race(:,i) = max(Raster(:,TRace(i)-1:TRace(i)+2),[],2);    %maybe this window can be optimized ???
    Race(:,i) = max(Raster(:,TRace(i)-1:TRace(i)+2),[],2);
     % Race(:,i) = max(Raster(:,TRace(i)-2:TRace(i)+3),[],2);  
    RasterRace(Race(:,i)==1,TRace(i)) = 1;                          %Raster with only activity in SCE time: all frames
end

%PCA...
Race=double(Race);

% [NCell, NRace] = size(Race);
% NClini=12;

% --- 1. PCA (Réduction de dimensionnalité) ---
% La PCA s'applique sur les cellules pour débruiter l'activité avant de calculer les corrélations entre SCE
% use_pca = true; % Mets à true pour tester
% if use_pca
% On projette les cellules dans un espace de dimension réduite
% Race est (NCell x NRace). PCA sur les features (Cellules)
warning('off', 'all');
[~, score, ~, ~, explained] = pca(Race'); %%%%dans ce sens ????
warning('on', 'all');

% On garde 80% de la variance
cumVar = cumsum(explained);
nPC = find(cumVar >= 80, 1);
% Race_For_Clustering devient (nPC x NRace)
% On transpose 'score' car tes fonctions attendent (Features x Events)
% Race_For_Clustering = score(:, 3:nPC)'; 
Race_For_Clustering = score(:, 3:30)'; 
function [IDXs,sCl,M,S,NClini] = kmeansoptnew(E,N,type,NClini) % on clusterize les SCE sur la base des cellules qui y participe

%E p parameters (cells) by N Events
%N number of trials per cluster number

Ne = size(E,2);

%% Covariance matrix
if strcmp(type,'var')
    M = CovarM(E);
end

IDX0=zeros(N,Ne);
NCl=NClini;
%cM = parallel.pool.Constant(M);
stream = RandStream('mlfg6331_64');  % Random number stream
options = statset('UseParallel',1,'UseSubstreams',1,...
    'Streams',stream);

IDX = kmeans(M,NCl,'Options',options,"MaxIter",10000,'OnlinePhase','on','Replicates',N);    % Kmeans on distance of covariance metric
S = median(silh(M,IDX));%original



[~,ClOK] = max(S); 
% test = prctile(S,95); 

%IDX = IDX0(ClOK,:);
s = silh(M,IDX);
sCl = zeros(1,NCl);
for i = 1:NCl
    sCl(i) = median(s(IDX==i));%original
end

%sort RACE/silhouette of best cluster
[sCl,xCl] = sort(sCl,'descend');
IDXs = zeros(1,Ne);
for i = 1:NCl
    IDXs = IDXs + (IDX == xCl(i))*i;
end

